{
    "name": "fabric-interrogator",
    "version": "0.1.0",
    "description": "Gets commissioned onto a Matter fabric, discovers all devices, and displays their attributes",
    "private": true,
    "license": "MIT",
    "author": "Chernyshov",
    "type": "module",
    "scripts": {
        "prepare": "tsc",
        "build": "tsc",
        "app": "node --enable-source-maps dist/FabricInterrogator.js",
