    },
    "engines": {
        "node": ">=20.19.0 <22.0.0 || >=22.13.0"
    },
    "dependencies": {
        "@matter/main": "0.16.10",
        "@matter/model": "0.16.10",
        "@matter/protocol": "0.16.10",
        "@matter/types": "0.16.10",
        "@project-chip/matter.js": "0.16.10"
    },
    "optionalDependencies": {
        "@matter/nodejs-ble": "0.16.10"
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "typescript": "~5.9.3"
    }
}
